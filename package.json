{
  "name": "control-deck",
  "version": "0.1.0",
  "type": "module",
  "main": ".electron-dist/main.js",
  "description": "Agentic cockpit — web, terminal, and native surfaces under one shell",
  "author": "Control Deck",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3333",
    "build": "next build",
    "start": "next start -p 3333",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:voice": "bun test tests/voice-harness/integration/ lib/voice/test-harness/",
    "test:voice:e2e": "playwright test --config tests/voice-harness/e2e/playwright.config.ts",
    "test:voice:batch": "bun tests/voice-harness/run-batch.ts",
    "eval:mcp-tools": "bun scripts/mcp-tool-eval.ts",
    "eval:mcp-live": "bun scripts/mcp-tool-eval.ts --mode live",
    "eval:agent-work": "bun scripts/mcp-tool-eval.ts --mode work",
    "eval:agent-work:unit": "bun test lib/evals/agentWorkEval.test.ts",
    "eval:agent-work:export": "bun scripts/export-agent-work-training-data.ts",
    "postinstall": "node scripts/copy-vad-assets.cjs",
    "terminal-service": "tsx scripts/terminal-service.ts",
    "omni:sidecar": "test -x .venv-omni/bin/python && .venv-omni/bin/python scripts/qwen-omni-sidecar.py || echo '[omni:sidecar] .venv-omni not found — create it with: uv venv .venv-omni && uv pip install -r scripts/requirements-omni.txt'",
    "omni:smoke": "test -x .venv-omni/bin/python && .venv-omni/bin/python scripts/qwen-omni-smoke.py || echo '[omni:smoke] .venv-omni not found — create it with: uv venv .venv-omni && uv pip install -r scripts/requirements-omni.txt'",
    "voice:core": "cd apps/voice-core && uv run voice-core serve --host 127.0.0.1 --port 4245",
    "mcp:stdio": "tsx scripts/mcp-stdio.ts",
    "native": "bun lib/tools/native/cli.ts",
    "catalog": "bun scripts/model-catalog.ts",
    "electron:compile": "rm -rf .electron-dist && tsc -p electron/tsconfig.json && node scripts/postbuild-electron.cjs",
    "electron:macos-helper": "bash scripts/build-macos-helper.sh",
    "electron:win-host": "node scripts/build-win-host.cjs",
    "electron:terminal-service": "node scripts/build-terminal-service.cjs",
    "electron:dev": "bun run electron:macos-helper && bun run electron:win-host && bun run electron:compile && electron .electron-dist/main.js",
    "electron:build": "next build && node scripts/copy-native-binaries.cjs && bun run electron:terminal-service && bun run electron:win-host && bun run electron:compile",
    "electron:pack": "bun run electron:build && electron-builder --config electron-builder.yml",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3,node-pty,node-screenshots,koffi",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.1",
    "@ai-sdk/google": "^3.0.1",
    "@ai-sdk/openai": "^3.0.1",
    "@ai-sdk/openai-compatible": "^1.0.29",
    "@chenglou/pretext": "^0.0.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/model-viewer": "^4.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@ricky0123/vad-web": "^0.0.30",
    "@tanstack/react-virtual": "^3.14.2",
    "@types/ws": "^8.18.1",
    "@wterm/react": "^0.1.9",
    "ai": "^5.0.113",
    "better-sqlite3": "12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dockview-react": "^5.2.0",
    "dompurify": "^3.4.7",
    "duck-duck-scrape": "^2.2.7",
    "katex": "^0.17.0",
    "koffi": "^2.12.0",
    "lucide-react": "^0.561.0",
    "marked": "^18.0.2",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.55.1",
    "next": "^16.0.10",
    "node-pty": "^1.1.0",
    "node-screenshots": "^0.2.1",
    "onnxruntime-web": "^1.24.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.33.5",
    "smplr": "^0.20.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tone": "^15.1.22",
    "tw-animate-css": "^1.4.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "ws": "^8.20.0",
    "yaml": "^2.9.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/nextjs-vite": "^10.4.1",
    "@stryker-mutator/core": "^9.6.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.4",
    "@types/diff": "^8.0.0",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.10",
    "eslint-plugin-storybook": "^10.4.1",
    "fast-check": "^4.7.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "storybook": "^10.4.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "trustedDependencies": [
    "koffi"
  ]
}
